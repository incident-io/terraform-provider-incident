  {
    "name": "label and missing are dropped but real filters are kept",
    "document": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "varSpec",
              "attrs": {
                "label": "Payload → Description",
                "missing": true,
                "name": "description",
