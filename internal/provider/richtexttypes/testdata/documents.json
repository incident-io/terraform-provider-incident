  {
    "name": "dashboard-authored varSpec carrying label and missing",
    "document": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "varSpec",
              "attrs": { "label": "Payload → Description", "missing": false, "name": "description" }
